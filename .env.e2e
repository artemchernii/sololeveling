# The throwaway test backend on this Mac (pnpm e2e) — never his dev or
# prod. No secrets here: the Clerk keys are read from .env.local. The
# backend itself runs from e2e/backend, so the Convex CLI writes its own
# .env.local there and never touches the app's (5 Oct: run from the root,
# it rewrote the app's .env.local to point at the test backend).
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211
E2E_EMAIL=e2e+clerk_test@example.com
