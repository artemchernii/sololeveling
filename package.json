{
  "name": "sololeveling",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p convex --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:setup": "scripts/e2e-setup.sh",
    "verify": "pnpm typecheck && pnpm lint && pnpm check && pnpm test && pnpm build",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:dev": "scripts/deploy-dev.sh",
    "backup": "scripts/backup.sh",
    "backup:drill": "scripts/restore-drill.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@clerk/tanstack-react-start": "^1.4.21",
    "@clerk/themes": "^2.4.57",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.50",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.32.0",
    "convex-helpers": "^0.1.124",
    "country-flag-icons": "1.5.19",
    "date-fns": "^4.4.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rrule": "^2.8.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "uqr": "0.1.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.42",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "convex-test": "^0.0.56",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  },
  "packageManager": "pnpm@10.12.4"
}
